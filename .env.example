# The REST endpoint the internal team hosts. The Contact form POSTs its JSON
# payload here; the API turns it into an email. See BACKEND_INTEGRATION.md.
#
# Must be readable in the browser, hence the NEXT_PUBLIC_ prefix. It is a URL,
# not a secret — never put an API key in this file.
NEXT_PUBLIC_CONTACT_API_URL=https://api.example.internal/trihelix/contact

# Internal design review only: keeps the Figma reference overlays (press G) and
# /compare.html in the build. Leave unset for the hand-off build.
# NEXT_PUBLIC_DESIGN_REVIEW=1
